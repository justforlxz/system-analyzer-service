# 后端本地开发配置。复制为 backend/.env 后按需修改；backend/.env 不进仓库。
#
# 未配置的必填项会让进程启动直接失败，不做静默兜底。
SAS_DATABASE_URL=postgresql+asyncpg://sas:sas@127.0.0.1:55432/system_analyzer
SAS_LOG_LEVEL=INFO
SAS_API_HOST=127.0.0.1
SAS_API_PORT=8000
SAS_WORKER_ID=worker-local
SAS_WORKER_POLL_INTERVAL_SECONDS=2
SAS_WORKER_LOCK_TIMEOUT_SECONDS=900

# 集成测试使用的库地址（`uv run pytest -m integration`）。与 Settings 用同一前缀和同一个
# .env，所以写在这里或导出为环境变量都生效；两者都没有时该命令直接报错，不会静默跳过。
# 这些测试会清空 jobs 表，只指向本地开发库，不要指向任何真实环境。
SAS_TEST_DATABASE_URL=postgresql+asyncpg://sas:sas@127.0.0.1:55432/system_analyzer
